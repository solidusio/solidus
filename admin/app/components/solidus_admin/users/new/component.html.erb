<%= turbo_frame_tag :resource_form, target: "_top" do %>
  <%= render component("ui/modal").new(title: t(".title")) do |modal| %>
    <%= solidus_form_for @user, url: form_url, html: { id: form_id, autocomplete: "off" } do |f| %>
      <div class="flex flex-col gap-6 pb-4">
        <%= f.text_field(:email, class: "required") %>
        <%= f.password_field(:password, autocomplete: "new-password") %>
        <%= f.password_field(:password_confirmation, autocomplete: "new-password") %>

        <% if @user.respond_to?(:timezone) %>
          <div>
            <%= f.select(:timezone, ActiveSupport::TimeZone.all.map { [_1.to_s, _1.name] }, include_blank: t("spree.none")) %>
          </div>
        <% end %>
        <%= f.checkbox_row(:spree_role_ids, options: role_options, row_title: t(".roles"), layout: :subsection) %>
      </div>

      <% modal.with_actions do %>
        <form method="dialog">
          <%= render component("ui/button").new(scheme: :secondary, text: t(".cancel")) %>
        </form>
        <%= f.submit %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
