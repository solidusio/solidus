<%= page do %>
  <%= page_header do %>
    <%= page_header_back(back_url) %>
    <%= page_header_title(title) %>
    <%= page_header_actions do %>
      <%= render component("ui/button").new(
        tag: :a,
        text: t(".add_category"),
        href: solidus_admin.new_taxonomy_taxon_path(@taxonomy),
        data: { turbo_frame: :taxon_form },
        icon: "add-line"
      ) %>
    <% end %>
  <% end %>

  <%= render component("ui/panel").new do |panel| %>
    <% panel.with_section(wide: true, high: true) do %>
      <ol class="flex flex-col w-full bg-gray-25">
        <%= render component("taxonomies/show/taxon").new(
          taxon: @taxonomy.root,
          taxonomy: @taxonomy,
          prefix: "1",
        ) %>
      </ol>
    <% end %>
  <% end %>

  <%= turbo_frame_tag :taxon_form, target: "_top" %>
<% end %>
