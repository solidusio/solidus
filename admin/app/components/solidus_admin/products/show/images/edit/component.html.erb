<%= turbo_frame_tag :edit_image_modal, target: "_top" do %>
  <%= render component("ui/modal").new(title: t(".title")) do |modal| %>
    <%= solidus_form_for @image, url: form_url, html: { id: form_id } do |f| %>
      <div class="flex flex-col gap-6 pb-4">
        <% if @image.attachment.attached? %>
          <div class="flex items-center gap-4">
            <%= image_with_fallback(@image) %>
            <div>
              <p class="text-sm font-medium"><%= @image.attachment.filename %></p>
              <p class="text-xs text-gray-500"><%= number_to_human_size(@image.attachment.byte_size) %></p>
            </div>
          </div>
        <% else %>
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 bg-gray-200 rounded"></div>
            <div>
              <p class="text-sm font-medium"><%= @image.attachment.filename %></p>
              <p class="text-xs text-gray-500"><%= t(".no_file") %></p>
            </div>
          </div>
        <% end %>
        <%= render component("ui/forms/field").text_field(f, :alt, label: t("spree.alt")) %>
      </div>
      <% modal.with_actions do %>
        <form method="dialog">
          <%= render component("ui/button").new(scheme: :secondary, text: t(".cancel")) %>
        </form>
        <%= render component("ui/button").new(form: form_id, type: :submit, text: t(".update")) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
