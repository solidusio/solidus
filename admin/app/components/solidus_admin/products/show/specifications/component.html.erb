<div id="specifications_panel">
  <%= render component("ui/panel").new(title: t(".title")) do |panel| %>
    <% panel.with_section do %>
      <div class="flex flex-col gap-4">
        <% groups.each do |group| %>
          <div class="flex gap-2 justify-between">
            <div class="flex flex-col gap-2">
              <div class="flex gap-2 items-baseline">
                <span class="font-semibold text-sm"><%= group.title %></span>
                <span class="text-sm text-gray-500"><%= group.scope %></span>
              </div>
              <% if group.values.any? %>
                <div class="flex gap-2 flex-wrap">
                  <% group.values.each do |value| %>
                    <%= render component("ui/badge").new(name: value) %>
                  <% end %>
                </div>
              <% else %>
                <span class="text-sm text-gray-500"><%= t(".empty") %></span>
              <% end %>
            </div>
            <% if group.edit_href %>
              <div class="flex items-center">
                <%= render component("ui/button").new(
                  tag: :a,
                  href: group.edit_href,
                  scheme: :secondary,
                  text: t(".edit"),
                  data: { turbo_frame: :specifications_modal }
                ) %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% panel.with_section do %>
      <div class="flex gap-2">
        <%= render component("ui/button").add(
          text: t(".add_group"),
          path: solidus_admin.new_product_variant_property_rule_path(@product),
          scheme: :secondary,
          data: { turbo_frame: :specifications_modal }
        ) %>
        <%= render component("ui/button").new(
          tag: :a,
          href: spree.admin_product_product_properties_path(@product),
          scheme: :secondary,
          text: t(".manage_properties")
        ) %>
      </div>
    <% end %>
  <% end %>
</div>
