<div class="mb-8">
  <h6 class="text-gray-500 mb-3">
    Enabled
  </h6>

  <%= render current_component.new(
    type: "Spree::PaymentMethod::BogusCreditCard",
    preference_name: :bogus_password,
    name: "field_name_for_rails_form",
    value: "prefilled value",
  ) %>
</div>

<div class="mb-8">
  <h6 class="text-gray-500 mb-3">
    With an error
  </h6>

  <%= render current_component.new(
    type: "Spree::PaymentMethod::BogusCreditCard",
    preference_name: :bogus_password,
    name: "field_name_for_rails_form",
    error: "Error message to be displayed",
    value: "prefilled value",
  ) %>
</div>

<div class="mb-8">
  <h6 class="text-gray-500 mb-3">
    Disabled
  </h6>

  <%= render current_component.new(
    type: "Spree::PaymentMethod::BogusCreditCard",
    preference_name: :bogus_password,
    disabled: true,
    name: "field_name_for_rails_form",
    value: "prefilled value",
  ) %>
</div>

<div class="mb-8">
  <h6 class="text-gray-500 mb-3">
    Without hint or translated label
  </h6>

  <%= render current_component.new(
    type: "Spree::PaymentMethod::BogusCreditCard",
    preference_name: :unregistered,
    name: "field_name_for_rails_form",
  ) %>
</div>
