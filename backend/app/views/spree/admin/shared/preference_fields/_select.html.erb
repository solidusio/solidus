<%
  label = local_assigns[:label].presence
  html_options = {class: 'select2 fullwidth'}.update(local_assigns[:html_options] || {})
%>

<div class="field">
  <% if local_assigns[:form] %>
    <%= form.label attribute, label %>
    <%= form.select attribute, local_assigns[:options], {}, html_options %>
  <% else %>
    <%= label_tag name, label %>
    <%= select_tag name, local_assigns[:options], {}, html_options %>
  <% end %>
</div>
